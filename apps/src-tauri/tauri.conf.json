{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auduio",
  "version": "0.4.0",
  "identifier": "com.thebrainwaves.auduio",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auduio",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#121017",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A multitrack recording machine",
    "longDescription": "Auduio is a multitrack recorder with an arrangement and session view, effects, tempo detection and a phone-friendly mode.",
    "copyright": "thebrainwaves",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "gstreamer1.0-pulseaudio"
        ]
      }
    },
    "externalBin": [
      "binaries/auduio-engine"
    ]
  }
}
